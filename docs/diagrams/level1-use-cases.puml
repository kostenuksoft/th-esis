@startuml level1-use-cases
!include rose-common.iuml
left to right direction
skinparam nodesep 10
skinparam ranksep 38
title Kohaku – діаграма варіантів використання (контекст системи)

actor "Гравець" as player
actor "Перевіряльник\nрезультатів" as verifier
actor "Автор модифікацій" as author

actor "ОС Windows" as windows <<system>>
actor "Графічний адаптер" as gpu <<system>>

rectangle "Kohaku" as system {
  usecase "Налаштувати гру" as settings
  usecase "Грати сеанс" as play
  usecase "Переглянути\nзапис сеансу" as review
  usecase "Перевірити\nзапис сеансу" as verify
  usecase "Дизасемблювати ресурс" as disasm
  usecase "Асемблювати ресурс" as asm
  usecase "Упакувати архів" as pack
  usecase "Підготувати текстури" as bake

  usecase "Переглянути діалог" as dialogue
  usecase "Призупинити гру" as pause
  usecase "Записати сеанс" as record
  usecase "Виявити першу\nрозбіжність стану" as diverge
  usecase "Звірити версію\nзбірки й ресурсів" as version
  usecase "Перевірити зворотне\nперетворення" as roundtrip
}

player --> settings
player --> play
player --> review
verifier --> verify
author --> disasm
author --> asm
author --> pack
author --> bake

play <.. dialogue : <<extend>>
play <.. pause : <<extend>>
play ..> record : <<include>>
review ..> diverge : <<include>>
verify ..> version : <<include>>
verify ..> diverge : <<include>>
asm ..> roundtrip : <<include>>

system -down-> windows
system -down-> gpu
@enduml
